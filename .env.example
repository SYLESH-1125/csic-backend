# Forensic AI Engine (FastAPI) — copy to .env and fill in values.
# cp .env.example .env

# ---------------------------------------------------------------------------
# Required for production (use a strong random value)
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG=true
DATABASE_URL=sqlite:///data/ledger.db

# ---------------------------------------------------------------------------
# Storage (defaults match app/config.py)
# ---------------------------------------------------------------------------
# SQLITE_DB_PATH=data/ledger.db
# RAW_STORAGE_PATH=data/raw
# PARQUET_STORAGE_PATH=data/parquet
# WORM_STORAGE_PATH=data/worm
# QUARANTINE_PATH=data/quarantine
# TEMP_CHUNKS_PATH=data/temp

# ---------------------------------------------------------------------------
# Phase 1 — JIT ingestion
# ---------------------------------------------------------------------------
SESSION_TTL_MINUTES=30

# Set to false to disable auto Phase-2 trigger after ingest (ws_router / ingestion router)
# AUTO_TRIGGER_PHASE2=true

# ---------------------------------------------------------------------------
# Phase 2 → Phase 3 webhook (same host as uvicorn unless split)
# ---------------------------------------------------------------------------
# PHASE3_WEBHOOK_URL=http://127.0.0.1:8000/api/phase3/phase2_webhook

# ---------------------------------------------------------------------------
# Phase 3 — hot/cold gateway (when /api/phase3 mounts)
# ---------------------------------------------------------------------------
# PHASE3_HOT_DB_PATH=data/phase3_hot.duckdb
# PHASE3_COLD_DIR=data/phase3_cold
# PHASE3_TTL_SECONDS=30
# PHASE3_PRIVACY_BYPASS=false

# ---------------------------------------------------------------------------
# Phase 3 — AWS S3 cold storage (optional; when unset, uses local Parquet)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=           # MinIO/LocalStack override (e.g. http://localhost:9000)

# ---------------------------------------------------------------------------
# Phase 5 agents (optional; not exposed on main API yet)
# ---------------------------------------------------------------------------
# GEMINI_KEY=
# ─── Operation Room Environment ───────────────────────────────
# Copy this to .env and fill in your values.

# ═══════════════════════════════════════════════════════════════
# LLM PROVIDER CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# LLM Provider: "ollama" (default, local) or "gemini" (Google API)
OPROOM_LLM_PROVIDER=gemini
OPROOM_LLM_MODEL=gemini-2.5-pro

# Ollama (local LLM - no API key needed)
OPROOM_OLLAMA_URL=http://localhost:11434

# ─── Google Gemini API Keys ───────────────────────────────────
# Get your keys at: https://aistudio.google.com/apikey
# You can use a single key OR multiple keys for rotation

# Option 1: Single key
# OPROOM_GEMINI_API_KEY=

# Option 2: Multiple keys (comma-separated for load balancing)
OPROOM_GEMINI_API_KEYS=AIzaSyDqEMH8AHWE6n7L5FonfHriN2bXhHyxWWw,AIzaSyCEHx9L3AfsEI6OtMt4AwdxFd6wuKKd4fg,AIzaSyBXjdkZTXHqe-aNeRN3cmskgKleL5m2MaI,AIzaSyCAdB0LCTFTmifYVF1XfFmkssAMVE0Qs2g,AIzaSyA0iEEnohhkyq22wdTeuJkx2E3zCURSuGA,AIzaSyAWdLzxLvUJI0Fn6ETAKwsKTjeET2Xhgh4

# ─── OpenAI API Keys (optional) ───────────────────────────────
# OPENAI_API_KEY=your_openai_key
# OPENAI_API_KEYS=key1,key2,key3

# ─── Key Rotation Strategy ────────────────────────────────────
# Options: round_robin (default), random, least_used
OPROOM_KEY_ROTATION=round_robin

# ═══════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════

# CORS (main shell :3000 + Operation Room Next :3001; include 127.0.0.1 if you use that origin)
OPROOM_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]