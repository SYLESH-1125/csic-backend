# Use pyproject.toml for Vercel dependency resolution (avoid dual-file ambiguity)
requirements.txt

# Frontend app (deploy backend only from repo root)
csic_frontend/

# Local data and caches
data/
node_modules/
__pycache__/
*.pyc
.env
.env.*

# Heavy phases / modules not loaded on Vercel (see app/main.py _IS_VERCEL)
app/phase_5_CISC/
app/phase3/
app/reporting/
app/features/
app/detection/
app/dashboard/
app/parsing/

# Tests, docs, and archives not needed at runtime
**/tests/
**/*.md
app/phase_5_CISC/docs/
app/phase_5_CISC/archive_scripts/
app/phase_5_CISC/operation-room/backend/archive/
app/phase_5_CISC/operation-room/docs/
app/phase_5_CISC/.copilot-tracking/
app/phase_5_CISC/.github/
