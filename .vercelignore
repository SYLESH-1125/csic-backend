# Deploy Next.js UI from csic_frontend (not the Python API at repo root).
# IMPORTANT: use /app/ patterns (root-only) — plain "app/" also ignores csic_frontend/app/

# Python / FastAPI — use Render for backend, not this Vercel project
pyproject.toml
uv.lock
requirements.txt
.python-version
.venv/
venv/
/data/

# Ignore repo-root Python tree, but keep Operation Room frontend sources for @operation-room imports
/app/*
!/app/phase_5_CISC/
/app/phase_5_CISC/*
!/app/phase_5_CISC/operation-room/
/app/phase_5_CISC/operation-room/*
!/app/phase_5_CISC/operation-room/frontend/
/app/phase_5_CISC/operation-room/frontend/*
!/app/phase_5_CISC/operation-room/frontend/src/
!/app/phase_5_CISC/operation-room/frontend/tailwind.config.js

# Caches / local
node_modules/
__pycache__/
*.pyc
.env
.env.*

# Docs / tests
**/tests/
**/*.md
