# Copy to .env.local. Phase 6 embeds this app from the main NFLIP shell (csic_frontend) on :3000.

# Forensic Engine with Phase 5 Operation Room mounted at /api/phase5 (default backend :8000).
OPROOM_BACKEND_ORIGIN=http://127.0.0.1:8000/api/phase5
# next.config.mjs also reads NEXT_PUBLIC_API_URL (same value is fine).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/phase5

# Magic Query (Phase 4) at /cases/:id/import — server routes call the main API for parsed-logs.
# Use the FastAPI root (not /api/phase5) so GET /api/phase4/parsed-logs resolves.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# GEMINI_API_KEY=your-google-ai-studio-key
