"""
Master Orchestrator Agent — Central Coordinator for Multi-Agent Report Automation.

The Master Orchestrator is the brain of the automated report generation system.
It receives high-level requests (scenarios/hypotheses), decomposes them into
sub-tasks, routes work to specialized agents, and aggregates final outputs.

Pipeline Architecture:
─────────────────────────────────────────────────────────────────────────────────
   ┌─────────────────────────────────────────────────────────────────────────┐
   │                         ORCHESTRATOR PIPELINE                           │
   │                                                                         │
   │  ┌──────────┐   ┌──────────┐   ┌──────────┐   ┌──────────┐            │
   │  │  PARSE   │──▶│ DECOMPOSE│──▶│ SCHEDULE │──▶│ DISPATCH │            │
   │  │ REQUEST  │   │  TASKS   │   │  AGENTS  │   │  & RUN   │            │
   │  └──────────┘   └──────────┘   └──────────┘   └──────────┘            │
   │                                                    │                   │
   │                                                    ▼                   │
   │  ┌──────────┐   ┌──────────┐   ┌──────────┐   ┌──────────┐            │
   │  │  FINAL   │◀──│ VALIDATE │◀──│ AGGREGATE│◀──│ MONITOR  │            │
   │  │  OUTPUT  │   │ RESULTS  │   │ RESULTS  │   │ PROGRESS │            │
   │  └──────────┘   └──────────┘   └──────────┘   └──────────┘            │
   └─────────────────────────────────────────────────────────────────────────┘
─────────────────────────────────────────────────────────────────────────────────

Key Responsibilities:
1. Parse incoming scenario/hypothesis requests
2. Decompose into atomic tasks with dependency graph
3. Schedule agent execution respecting dependencies
4. Monitor agent progress and handle failures
5. Aggregate results from all agents
6. Validate output integrity
7. Generate final automated report

Research Integration:
- Task decomposition based on forensic investigation methodologies
- Agent scheduling optimized for DFIR workflows
- Result validation using confidence scoring

Author: NFLIP Development Team
Version: 1.0.0
"""

import json
import uuid
import logging
import asyncio
from datetime import datetime, timezone
from typing import TypedDict, Optional, Any, Dict, List, Literal
from enum import Enum
from dataclasses import dataclass, field

from langgraph.graph import StateGraph, END

from app.agents.base import (
    BaseAgent, BaseAgentState, AgentStatus, AgentMessage, 
    MessageType, AgentRegistry, registry
)
from app.services.llm_provider import get_llm
from app.services.audit_service import record_coc_event
from app.database import open_vault

logger = logging.getLogger(__name__)


def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


# ═══════════════════════════════════════════════════════════════════════════════
# TASK DEFINITIONS
# ═══════════════════════════════════════════════════════════════════════════════

class TaskType(str, Enum):
    """Types of tasks the orchestrator can dispatch."""
    HYPOTHESIS_ANALYSIS = "hypothesis_analysis"
    EVIDENCE_COLLECTION = "evidence_collection"
    MODULE_EVALUATION = "module_evaluation"
    CONFIDENCE_SCORING = "confidence_scoring"
    SUMMARY_SYNTHESIS = "summary_synthesis"
    RESEARCH_LOOKUP = "research_lookup"


class TaskStatus(str, Enum):
    """Task execution status."""
    PENDING = "pending"
    QUEUED = "queued"
    RUNNING = "running"
    COMPLETED = "completed"
    FAILED = "failed"
    SKIPPED = "skipped"


@dataclass
class Task:
    """
    Atomic unit of work for the orchestrator.
    
    Attributes:
        task_id: Unique identifier
        task_type: Category of task
        agent_id: Target agent to execute this task
        input_data: Data to pass to the agent
        dependencies: List of task_ids that must complete first
        priority: Execution priority (lower = higher priority)
        status: Current status
        result: Output from the agent
        error: Error message if failed
    """
    task_id: str = field(default_factory=lambda: str(uuid.uuid4()))
    task_type: TaskType = TaskType.HYPOTHESIS_ANALYSIS
    agent_id: str = ""
    input_data: Dict[str, Any] = field(default_factory=dict)
    dependencies: List[str] = field(default_factory=list)
    priority: int = 3
    status: TaskStatus = TaskStatus.PENDING
    result: Optional[Dict[str, Any]] = None
    error: Optional[str] = None
    started_at: Optional[str] = None
    completed_at: Optional[str] = None
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            "task_id": self.task_id,
            "task_type": self.task_type.value,
            "agent_id": self.agent_id,
            "input_data": self.input_data,
            "dependencies": self.dependencies,
            "priority": self.priority,
            "status": self.status.value,
            "result": self.result,
            "error": self.error,
            "started_at": self.started_at,
            "completed_at": self.completed_at,
        }


# ═══════════════════════════════════════════════════════════════════════════════
# ORCHESTRATOR STATE
# ═══════════════════════════════════════════════════════════════════════════════

class OrchestratorState(TypedDict, total=False):
    """State schema for the orchestrator pipeline."""
    # Request context
    case_id: str
    run_id: str
    scenario: str
    hypothesis: Dict[str, Any]
    report_type: Literal["technical", "executive", "regulatory"]
    llm_provider: str
    
    # Task management
    tasks: List[Dict[str, Any]]
    task_graph: Dict[str, List[str]]  # task_id -> [dependent_task_ids]
    completed_tasks: List[str]
    failed_tasks: List[str]
    
    # Agent results
    hypothesis_result: Dict[str, Any]
    evidence_result: Dict[str, Any]
    module_results: Dict[str, Dict[str, Any]]  # module_name -> result
    confidence_result: Dict[str, Any]
    synthesis_result: Dict[str, Any]
    
    # Final output
    final_report: Dict[str, Any]
    report_markdown: str
    report_hash: str
    
    # Metadata
    status: str
    progress: float  # 0.0 - 1.0
    started_at: str
    completed_at: Optional[str]
    duration_ms: Optional[int]
    error: Optional[str]
    coc_event_id: str
    
    # Reasoning trace
    reasoning_steps: List[Dict[str, Any]]


# ═══════════════════════════════════════════════════════════════════════════════
# ORCHESTRATOR PROMPTS
# ═══════════════════════════════════════════════════════════════════════════════

DECOMPOSITION_PROMPT = """You are a forensic investigation orchestrator. Given a scenario or hypothesis, 
decompose it into specific investigation tasks.

SCENARIO:
{scenario}

AVAILABLE MODULES:
- timeline: Event timeline reconstruction and analysis
- anomaly: ML-based anomaly detection with SHAP explainability
- correlation: Entity correlation and attack chain mapping
- crud: CRUD operation analysis for data access patterns
- network: Network flow and exfiltration detection
- depth: Blast radius and impact assessment

INSTRUCTIONS:
1. Identify the key investigative questions to answer
2. Map each question to relevant modules
3. Determine dependencies between questions
4. Prioritize critical path items

OUTPUT (JSON):
{{
    "investigation_questions": [
        {{"question": "...", "modules": ["..."], "priority": 1-5}}
    ],
    "evidence_requirements": ["..."],
    "expected_findings": ["..."],
    "risk_indicators": ["..."]
}}"""

AGGREGATION_PROMPT = """You are a forensic report synthesizer. Aggregate findings from multiple 
investigation modules into a coherent narrative.

CASE CONTEXT:
{case_context}

MODULE RESULTS:
{module_results}

CONFIDENCE SCORES:
{confidence_scores}

INSTRUCTIONS:
1. Identify the most significant findings across all modules
2. Establish the attack chain / incident timeline
3. Quantify the impact (affected systems, data, users)
4. Provide evidence-backed conclusions
5. Generate actionable recommendations

OUTPUT (JSON):
{{
    "executive_summary": "...",
    "key_findings": [...],
    "attack_chain": [...],
    "impact_assessment": {{...}},
    "recommendations": [...],
    "confidence_level": "high|medium|low",
    "evidence_citations": [...]
}}"""


# ═══════════════════════════════════════════════════════════════════════════════
# PIPELINE NODES
# ═══════════════════════════════════════════════════════════════════════════════

def parse_request(state: OrchestratorState) -> dict:
    """
    Node 1: Parse and validate the incoming request.
    
    - Validates case exists
    - Extracts scenario/hypothesis
    - Sets up execution context
    """
    run_id = state.get("run_id", str(uuid.uuid4()))
    case_id = state["case_id"]
    
    logger.info(f"[{run_id}] Parsing request for case {case_id}")
    
    # Validate case exists
    try:
        conn = open_vault(case_id)
        case_row = conn.execute(
            "SELECT case_id, title, description, status FROM cases WHERE case_id = ? LIMIT 1",
            [case_id]
        ).fetchone()
        
        if not case_row:
            return {
                "status": "failed",
                "error": f"Case {case_id} not found"
            }
        
        # Initialize state
        return {
            "run_id": run_id,
            "status": "parsing",
            "started_at": _now_iso(),
            "progress": 0.05,
            "tasks": [],
            "completed_tasks": [],
            "failed_tasks": [],
            "module_results": {},
            "reasoning_steps": [{
                "step": "parse_request",
                "description": f"Validated case {case_id}",
                "timestamp": _now_iso(),
                "details": {
                    "case_title": case_row[1],
                    "case_status": case_row[3]
                }
            }]
        }
    except Exception as e:
        logger.error(f"[{run_id}] Parse error: {e}")
        return {
            "status": "failed",
            "error": str(e)
        }


async def decompose_tasks(state: OrchestratorState) -> dict:
    """
    Node 2: Decompose the scenario into atomic tasks.
    
    Uses LLM to analyze the scenario and identify:
    - Investigation questions
    - Required evidence
    - Module dependencies
    """
    run_id = state["run_id"]
    scenario = state.get("scenario", "")
    llm_provider = state.get("llm_provider", "ollama")
    
    logger.info(f"[{run_id}] Decomposing scenario into tasks")
    
    # Use LLM for intelligent decomposition
    llm = get_llm(provider=llm_provider)
    prompt = DECOMPOSITION_PROMPT.format(scenario=scenario)
    
    try:
        response = await llm.generate(
            prompt=prompt,
            system="You are a forensic investigation planner. Output valid JSON only.",
            temperature=0.2
        )
        
        # Parse LLM response
        decomposition = {}
        try:
            # Extract JSON from response
            json_start = response.find("{")
            json_end = response.rfind("}") + 1
            if json_start >= 0 and json_end > json_start:
                decomposition = json.loads(response[json_start:json_end])
        except json.JSONDecodeError:
            logger.warning(f"[{run_id}] Failed to parse LLM decomposition, using defaults")
    except Exception as e:
        logger.warning(f"[{run_id}] LLM decomposition failed: {e}, using defaults")
        decomposition = {}
    
    # Build task graph based on decomposition
    tasks = []
    task_graph = {}
    
    # Task 1: Hypothesis Analysis (always first)
    hypothesis_task = Task(
        task_type=TaskType.HYPOTHESIS_ANALYSIS,
        agent_id="hypothesis_analysis_agent",
        input_data={
            "scenario": scenario,
            "decomposition": decomposition,
            "case_id": state["case_id"]
        },
        priority=1
    )
    tasks.append(hypothesis_task)
    task_graph[hypothesis_task.task_id] = []
    
    # Task 2: Evidence Collection (depends on hypothesis)
    evidence_task = Task(
        task_type=TaskType.EVIDENCE_COLLECTION,
        agent_id="evidence_collection_agent",
        input_data={
            "case_id": state["case_id"],
            "hypothesis_task_id": hypothesis_task.task_id
        },
        dependencies=[hypothesis_task.task_id],
        priority=2
    )
    tasks.append(evidence_task)
    task_graph[evidence_task.task_id] = [hypothesis_task.task_id]
    
    # Task 3-8: Module Evaluations (can run in parallel, depend on evidence)
    modules = ["timeline", "anomaly", "correlation", "crud", "network", "depth"]
    module_task_ids = []
    
    for module in modules:
        module_task = Task(
            task_type=TaskType.MODULE_EVALUATION,
            agent_id=f"{module}_evaluation_agent",
            input_data={
                "case_id": state["case_id"],
                "module": module,
                "evidence_task_id": evidence_task.task_id
            },
            dependencies=[evidence_task.task_id],
            priority=3
        )
        tasks.append(module_task)
        task_graph[module_task.task_id] = [evidence_task.task_id]
        module_task_ids.append(module_task.task_id)
    
    # Task 9: Confidence Scoring (depends on all module evaluations)
    confidence_task = Task(
        task_type=TaskType.CONFIDENCE_SCORING,
        agent_id="confidence_scoring_agent",
        input_data={
            "case_id": state["case_id"],
            "module_task_ids": module_task_ids
        },
        dependencies=module_task_ids,
        priority=4
    )
    tasks.append(confidence_task)
    task_graph[confidence_task.task_id] = module_task_ids
    
    # Task 10: Summary Synthesis (depends on confidence scoring)
    synthesis_task = Task(
        task_type=TaskType.SUMMARY_SYNTHESIS,
        agent_id="summary_synthesis_agent",
        input_data={
            "case_id": state["case_id"],
            "report_type": state.get("report_type", "technical"),
            "confidence_task_id": confidence_task.task_id
        },
        dependencies=[confidence_task.task_id],
        priority=5
    )
    tasks.append(synthesis_task)
    task_graph[synthesis_task.task_id] = [confidence_task.task_id]
    
    return {
        "tasks": [t.to_dict() for t in tasks],
        "task_graph": task_graph,
        "status": "decomposed",
        "progress": 0.1,
        "reasoning_steps": state.get("reasoning_steps", []) + [{
            "step": "decompose_tasks",
            "description": f"Created {len(tasks)} tasks",
            "timestamp": _now_iso(),
            "details": {
                "task_count": len(tasks),
                "decomposition": decomposition
            }
        }]
    }


def schedule_agents(state: OrchestratorState) -> dict:
    """
    Node 3: Schedule agents based on task dependencies.
    
    - Identifies tasks with satisfied dependencies
    - Queues them for execution
    - Handles parallel execution where possible
    """
    run_id = state["run_id"]
    tasks = state["tasks"]
    completed = set(state.get("completed_tasks", []))
    task_graph = state.get("task_graph", {})
    
    logger.info(f"[{run_id}] Scheduling agents")
    
    # Find tasks ready to run
    ready_tasks = []
    for task in tasks:
        task_id = task["task_id"]
        if task["status"] in ["pending", "queued"]:
            deps = task_graph.get(task_id, [])
            if all(d in completed for d in deps):
                ready_tasks.append(task_id)
    
    # Update task statuses
    updated_tasks = []
    for task in tasks:
        if task["task_id"] in ready_tasks:
            task["status"] = "queued"
        updated_tasks.append(task)
    
    return {
        "tasks": updated_tasks,
        "status": "scheduling",
        "progress": 0.15,
        "reasoning_steps": state.get("reasoning_steps", []) + [{
            "step": "schedule_agents",
            "description": f"Queued {len(ready_tasks)} tasks",
            "timestamp": _now_iso(),
            "details": {"ready_tasks": ready_tasks}
        }]
    }


async def dispatch_and_run(state: OrchestratorState) -> dict:
    """
    Node 4: Dispatch tasks to agents and monitor execution.
    
    - Sends tasks to appropriate agents
    - Handles parallel execution
    - Collects results
    """
    run_id = state["run_id"]
    tasks = state["tasks"]
    
    logger.info(f"[{run_id}] Dispatching tasks to agents")
    
    # Find queued tasks
    queued_tasks = [t for t in tasks if t["status"] == "queued"]
    
    if not queued_tasks:
        return {
            "status": "no_tasks_queued",
            "progress": state.get("progress", 0.5)
        }
    
    # Execute tasks (in production, this would dispatch to actual agents)
    updated_tasks = []
    module_results = state.get("module_results", {})
    
    for task in tasks:
        if task["status"] == "queued":
            task["status"] = "running"
            task["started_at"] = _now_iso()
            
            # Simulate agent execution (actual implementation calls real agents)
            try:
                result = await _execute_task_stub(task, state)
                task["status"] = "completed"
                task["completed_at"] = _now_iso()
                task["result"] = result
                
                # Store results by type
                if task["task_type"] == "module_evaluation":
                    module_name = task["input_data"].get("module", "unknown")
                    module_results[module_name] = result
                    
            except Exception as e:
                task["status"] = "failed"
                task["completed_at"] = _now_iso()
                task["error"] = str(e)
        
        updated_tasks.append(task)
    
    # Calculate progress
    total = len(tasks)
    completed = len([t for t in updated_tasks if t["status"] == "completed"])
    progress = 0.15 + (0.7 * completed / total) if total > 0 else 0.5
    
    return {
        "tasks": updated_tasks,
        "module_results": module_results,
        "completed_tasks": [t["task_id"] for t in updated_tasks if t["status"] == "completed"],
        "failed_tasks": [t["task_id"] for t in updated_tasks if t["status"] == "failed"],
        "status": "executing",
        "progress": progress
    }


async def _execute_task_stub(task: Dict[str, Any], state: OrchestratorState) -> Dict[str, Any]:
    """
    Stub for task execution.
    
    In production, this dispatches to actual agent implementations.
    For now, returns mock results to demonstrate the architecture.
    """
    task_type = task.get("task_type", "")
    case_id = state.get("case_id", "")
    
    # Mock results based on task type
    if task_type == "hypothesis_analysis":
        return {
            "hypotheses": [
                {
                    "id": "h1",
                    "statement": "Unauthorized data access via compromised credentials",
                    "confidence": 0.85,
                    "evidence_required": ["login_anomalies", "data_access_logs"]
                }
            ],
            "entities": ["user_x", "db_server_1", "vpn_gateway"],
            "attack_vector": "credential_theft"
        }
    
    elif task_type == "evidence_collection":
        return {
            "evidence_items": 142,
            "sources": ["AUTH", "VPN", "DB", "FILE"],
            "time_range": {"start": "2024-01-01T00:00:00Z", "end": "2024-01-15T23:59:59Z"},
            "key_artifacts": ["auth_log_2024-01-05", "db_query_log_2024-01-10"]
        }
    
    elif task_type == "module_evaluation":
        module = task.get("input_data", {}).get("module", "unknown")
        return {
            "module": module,
            "findings_count": 15,
            "severity_distribution": {"critical": 2, "high": 5, "medium": 8},
            "confidence": 0.82
        }
    
    elif task_type == "confidence_scoring":
        return {
            "overall_confidence": 0.78,
            "factor_scores": {
                "evidence_coverage": 0.85,
                "module_agreement": 0.72,
                "temporal_consistency": 0.81,
                "cross_validation": 0.74
            },
            "confidence_level": "medium-high"
        }
    
    elif task_type == "summary_synthesis":
        return {
            "executive_summary": "Investigation reveals unauthorized data access...",
            "key_findings": ["Finding 1", "Finding 2", "Finding 3"],
            "recommendations": ["Rec 1", "Rec 2"],
            "report_generated": True
        }
    
    return {"status": "completed"}


def aggregate_results(state: OrchestratorState) -> dict:
    """
    Node 5: Aggregate results from all agents.
    
    - Combines module results
    - Resolves conflicts
    - Builds unified findings
    """
    run_id = state["run_id"]
    tasks = state.get("tasks", [])
    module_results = state.get("module_results", {})
    
    logger.info(f"[{run_id}] Aggregating results")
    
    # Extract key results
    hypothesis_result = None
    evidence_result = None
    confidence_result = None
    synthesis_result = None
    
    for task in tasks:
        if task["status"] == "completed" and task.get("result"):
            if task["task_type"] == "hypothesis_analysis":
                hypothesis_result = task["result"]
            elif task["task_type"] == "evidence_collection":
                evidence_result = task["result"]
            elif task["task_type"] == "confidence_scoring":
                confidence_result = task["result"]
            elif task["task_type"] == "summary_synthesis":
                synthesis_result = task["result"]
    
    return {
        "hypothesis_result": hypothesis_result,
        "evidence_result": evidence_result,
        "confidence_result": confidence_result,
        "synthesis_result": synthesis_result,
        "status": "aggregated",
        "progress": 0.9,
        "reasoning_steps": state.get("reasoning_steps", []) + [{
            "step": "aggregate_results",
            "description": "Aggregated results from all agents",
            "timestamp": _now_iso(),
            "details": {
                "modules_completed": list(module_results.keys()),
                "has_hypothesis": hypothesis_result is not None,
                "has_confidence": confidence_result is not None
            }
        }]
    }


def validate_results(state: OrchestratorState) -> dict:
    """
    Node 6: Validate aggregated results.
    
    - Checks completeness
    - Validates confidence thresholds
    - Identifies gaps
    """
    run_id = state["run_id"]
    
    logger.info(f"[{run_id}] Validating results")
    
    validation_issues = []
    
    # Check required results exist
    if not state.get("hypothesis_result"):
        validation_issues.append("Missing hypothesis analysis")
    if not state.get("evidence_result"):
        validation_issues.append("Missing evidence collection")
    if not state.get("confidence_result"):
        validation_issues.append("Missing confidence scoring")
    
    # Check module coverage
    expected_modules = {"timeline", "anomaly", "correlation", "crud", "network", "depth"}
    actual_modules = set(state.get("module_results", {}).keys())
    missing_modules = expected_modules - actual_modules
    
    if missing_modules:
        validation_issues.append(f"Missing modules: {missing_modules}")
    
    # Determine if validation passed
    validation_passed = len(validation_issues) == 0
    
    return {
        "status": "validated" if validation_passed else "validation_warning",
        "progress": 0.95,
        "reasoning_steps": state.get("reasoning_steps", []) + [{
            "step": "validate_results",
            "description": "Validation " + ("passed" if validation_passed else "has issues"),
            "timestamp": _now_iso(),
            "details": {
                "passed": validation_passed,
                "issues": validation_issues
            }
        }]
    }


def generate_final_output(state: OrchestratorState) -> dict:
    """
    Node 7: Generate the final report output.
    
    - Assembles final report structure
    - Computes integrity hash
    - Records Chain of Custody
    """
    run_id = state["run_id"]
    case_id = state["case_id"]
    
    logger.info(f"[{run_id}] Generating final output")
    
    # Build final report
    final_report = {
        "case_id": case_id,
        "run_id": run_id,
        "generated_at": _now_iso(),
        "report_type": state.get("report_type", "technical"),
        "hypothesis": state.get("hypothesis_result", {}),
        "evidence_summary": state.get("evidence_result", {}),
        "module_findings": state.get("module_results", {}),
        "confidence": state.get("confidence_result", {}),
        "synthesis": state.get("synthesis_result", {}),
        "reasoning_trace": state.get("reasoning_steps", [])
    }
    
    # Compute hash
    import hashlib
    report_str = json.dumps(final_report, sort_keys=True)
    report_hash = f"sha256:{hashlib.sha256(report_str.encode()).hexdigest()}"
    
    # Generate markdown summary
    synthesis = state.get("synthesis_result", {})
    report_markdown = f"""# Automated Forensic Report

**Case ID:** {case_id}
**Generated:** {_now_iso()}
**Report Type:** {state.get('report_type', 'technical')}
**Integrity Hash:** `{report_hash}`

## Executive Summary
{synthesis.get('executive_summary', 'No summary available.')}

## Key Findings
{chr(10).join(['- ' + f for f in synthesis.get('key_findings', [])])}

## Recommendations
{chr(10).join(['- ' + r for r in synthesis.get('recommendations', [])])}

## Confidence Assessment
Overall Confidence: {state.get('confidence_result', {}).get('overall_confidence', 'N/A')}

---
*This report was automatically generated by the NFLIP Multi-Agent System.*
"""
    
    # Record CoC event
    try:
        conn = open_vault(case_id)
        coc_event_id = record_coc_event(
            conn=conn,
            case_id=case_id,
            event_type="AUTO_REPORT_GENERATED",
            actor="orchestrator_agent",
            description=f"Automated report generated for run {run_id}",
            data_hash=report_hash
        )
    except Exception as e:
        logger.warning(f"[{run_id}] Failed to record CoC: {e}")
        coc_event_id = None
    
    return {
        "final_report": final_report,
        "report_markdown": report_markdown,
        "report_hash": report_hash,
        "coc_event_id": coc_event_id,
        "status": "completed",
        "progress": 1.0,
        "completed_at": _now_iso()
    }


def should_continue_execution(state: OrchestratorState) -> str:
    """
    Conditional edge: Determine if more tasks need execution.
    
    Returns:
        "continue" if tasks pending, "aggregate" if all done, "error" if failed
    """
    tasks = state.get("tasks", [])
    
    # Check for failures
    failed = [t for t in tasks if t["status"] == "failed"]
    if len(failed) > 2:  # Allow some failures
        return "error"
    
    # Check if all tasks complete
    pending = [t for t in tasks if t["status"] in ["pending", "queued", "running"]]
    if not pending:
        return "aggregate"
    
    return "continue"


# ═══════════════════════════════════════════════════════════════════════════════
# BUILD LANGGRAPH PIPELINE
# ═══════════════════════════════════════════════════════════════════════════════

def build_orchestrator_graph() -> StateGraph:
    """
    Construct the LangGraph state machine for the orchestrator.
    
    Graph structure:
        parse -> decompose -> schedule -> dispatch -> [loop or aggregate]
        aggregate -> validate -> output -> END
    """
    workflow = StateGraph(OrchestratorState)
    
    # Add nodes
    workflow.add_node("parse_request", parse_request)
    workflow.add_node("decompose_tasks", decompose_tasks)
    workflow.add_node("schedule_agents", schedule_agents)
    workflow.add_node("dispatch_and_run", dispatch_and_run)
    workflow.add_node("aggregate_results", aggregate_results)
    workflow.add_node("validate_results", validate_results)
    workflow.add_node("generate_final_output", generate_final_output)
    
    # Add edges
    workflow.set_entry_point("parse_request")
    workflow.add_edge("parse_request", "decompose_tasks")
    workflow.add_edge("decompose_tasks", "schedule_agents")
    workflow.add_edge("schedule_agents", "dispatch_and_run")
    
    # Conditional loop
    workflow.add_conditional_edges(
        "dispatch_and_run",
        should_continue_execution,
        {
            "continue": "schedule_agents",
            "aggregate": "aggregate_results",
            "error": "aggregate_results"  # Still aggregate partial results
        }
    )
    
    workflow.add_edge("aggregate_results", "validate_results")
    workflow.add_edge("validate_results", "generate_final_output")
    workflow.add_edge("generate_final_output", END)
    
    return workflow.compile()


# ═══════════════════════════════════════════════════════════════════════════════
# ORCHESTRATOR AGENT CLASS
# ═══════════════════════════════════════════════════════════════════════════════

class MasterOrchestrator(BaseAgent):
    """
    Master Orchestrator Agent.
    
    Coordinates all specialized agents to produce automated forensic reports.
    """
    
    def __init__(self, llm_provider: str = "ollama"):
        super().__init__(llm_provider=llm_provider)
        self._graph = build_orchestrator_graph()
    
    @property
    def agent_id(self) -> str:
        return "master_orchestrator"
    
    @property
    def agent_name(self) -> str:
        return "Master Orchestrator"
    
    @property
    def agent_description(self) -> str:
        return "Central coordinator for multi-agent report automation"
    
    @property
    def input_schema(self) -> Dict[str, Any]:
        return {
            "type": "object",
            "required": ["case_id"],
            "properties": {
                "case_id": {"type": "string", "description": "Target case ID"},
                "scenario": {"type": "string", "description": "Investigation scenario/hypothesis"},
                "report_type": {"type": "string", "enum": ["technical", "executive", "regulatory"]},
                "llm_provider": {"type": "string", "enum": ["ollama", "gemini"]}
            }
        }
    
    async def execute(self, state: BaseAgentState) -> BaseAgentState:
        """Execute the orchestrator pipeline."""
        # Convert base state to orchestrator state
        orchestrator_state: OrchestratorState = {
            "case_id": state.get("input_data", {}).get("case_id", ""),
            "scenario": state.get("input_data", {}).get("scenario", ""),
            "report_type": state.get("input_data", {}).get("report_type", "technical"),
            "llm_provider": state.get("input_data", {}).get("llm_provider", self.llm_provider),
            "run_id": state.get("run_id", str(uuid.uuid4()))
        }
        
        # Run the graph
        result = await self._graph.ainvoke(orchestrator_state)
        
        # Update base state with results
        state["output_data"] = {
            "final_report": result.get("final_report"),
            "report_markdown": result.get("report_markdown"),
            "report_hash": result.get("report_hash"),
            "confidence": result.get("confidence_result"),
            "module_results": result.get("module_results"),
            "reasoning_trace": result.get("reasoning_steps")
        }
        
        return state
    
    async def generate_report(
        self,
        case_id: str,
        scenario: str = "",
        report_type: str = "technical",
        llm_provider: str = None
    ) -> Dict[str, Any]:
        """
        Convenience method to generate a complete automated report.
        
        Args:
            case_id: Target case identifier
            scenario: Investigation scenario or hypothesis text
            report_type: Type of report (technical, executive, regulatory)
            llm_provider: LLM provider to use (ollama, gemini)
            
        Returns:
            Complete report with findings, confidence scores, and markdown
        """
        state: BaseAgentState = {
            "run_id": str(uuid.uuid4()),
            "case_id": case_id,
            "input_data": {
                "case_id": case_id,
                "scenario": scenario,
                "report_type": report_type,
                "llm_provider": llm_provider or self.llm_provider
            }
        }
        
        result = await self.run(state)
        return result.get("output_data", {})


# Register with global registry
registry.register(MasterOrchestrator())
